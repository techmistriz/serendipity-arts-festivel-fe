NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Blaksand
# Server-only Laravel API URL. Never expose customer access tokens through NEXT_PUBLIC_ variables.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1/web
# Public media origin used only for browser-visible Laravel CDN images.
NEXT_PUBLIC_CDN_URL=http://127.0.0.1:8000/uploads
NEXT_PUBLIC_GAME_URL=http://localhost:8080
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_CURRENCY_LOCALE=en-IN
